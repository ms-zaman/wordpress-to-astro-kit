---
import type { HTMLAttributes } from "astro/types";

/**
 * Text — body text rendering with token-based size and tone variants.
 */
interface Props extends HTMLAttributes<"p"> {
  /** Rendered element. Defaults to a paragraph. */
  as?: "p" | "span" | "div";
  /** Type-scale role. Defaults to md. */
  size?: "lg" | "md" | "sm" | "caption";
  /** Colour tone. Defaults to the standard text colour. */
  tone?: "default" | "muted";
}

const {
  as: Tag = "p",
  size = "md",
  tone = "default",
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={["wpk-text", `wpk-text--${size}`, `wpk-text--${tone}`, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .wpk-text {
    margin-block: 0;
    font-family: var(--font-family-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
  }

  .wpk-text--lg {
    font-size: var(--font-size-body-lg);
  }

  .wpk-text--md {
    font-size: var(--font-size-body-md);
  }

  .wpk-text--sm {
    font-size: var(--font-size-body-sm);
  }

  .wpk-text--caption {
    font-size: var(--font-size-caption);
  }

  .wpk-text--default {
    color: var(--color-text);
  }

  .wpk-text--muted {
    color: var(--color-text-muted);
  }
</style>
