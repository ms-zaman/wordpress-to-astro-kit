---
// Navigation — renders a menu built by `rendering/navigation-model.ts`.
//
// Second-level items: above the menu breakpoint they are a flyout, opened by
// `:hover` and by `:focus-within` — both, because hover alone is unreachable
// from a keyboard. Below it the flyout is unwrapped into an indented nested
// list, which is what a submenu honestly is when there is no pointer to hover
// with.
import type { NavigationNode } from "../../rendering/navigation-model.ts";

interface Props {
  items: readonly NavigationNode[];
  /** Accessible name. Two navs on one page must not share one. */
  label: string;
  /** `bar` is the header's menu; `columns` is the footer's list. */
  variant?: "bar" | "columns";
}

const { items, label, variant = "bar" } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label={label} class:list={["wpk-nav", `wpk-nav--${variant}`]}>
      {variant === "bar" ? (
        <ul role="list" class="wpk-nav__list">
          {items.map((item) => (
            <li class="wpk-nav__item">
              <a
                class="wpk-nav__link"
                href={item.href}
                aria-current={item.current ? "page" : undefined}
                data-within={item.containsCurrent ? "true" : undefined}
              >
                {item.label}
                {item.children.length > 0 && (
                  <span class="wpk-nav__caret" aria-hidden="true" />
                )}
              </a>
              {item.children.length > 0 && (
                <ul role="list" class="wpk-nav__flyout">
                  {item.children.map((child) => (
                    <li>
                      <a
                        class="wpk-nav__link wpk-nav__link--child"
                        href={child.href}
                        aria-current={child.current ? "page" : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <ul role="list" class="wpk-nav__columns">
          {items.map((item) => (
            <li class="wpk-nav__column">
              <a
                class="wpk-nav__link wpk-nav__link--group"
                href={item.href}
                aria-current={item.current ? "page" : undefined}
              >
                {item.label}
              </a>
              {item.children.length > 0 && (
                <ul role="list" class="wpk-nav__sublist">
                  {item.children.map((child) => (
                    <li>
                      <a
                        class="wpk-nav__link wpk-nav__link--child"
                        href={child.href}
                        aria-current={child.current ? "page" : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )}
    </nav>
  )
}

<style>
  .wpk-nav ul {
    margin-block: 0;
    padding-inline-start: 0;
    list-style: none;
  }

  .wpk-nav__link {
    color: inherit;
    text-decoration: none;
    font-size: var(--font-size-body-sm);
    transition: color var(--transition-fast);
  }

  .wpk-nav__link:hover,
  .wpk-nav__link:focus-visible {
    color: var(--color-link);
  }

  .wpk-nav__link:focus-visible {
    border-radius: var(--radius-sm);
  }

  /* The current page, and the branch it sits in: `aria-current` carries it
     to assistive tech, these carry it visually. */
  .wpk-nav__link[aria-current="page"] {
    color: var(--color-link);
    font-weight: var(--font-weight-medium);
  }

  .wpk-nav__link[data-within="true"]:not([aria-current="page"]) {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  .wpk-nav__link--group {
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
  }

  .wpk-nav--columns .wpk-nav__link--child {
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------- */
  /* bar — the header                                                  */
  /* ---------------------------------------------------------------- */

  .wpk-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
  }

  @media (min-width: 1025px) {
    .wpk-nav--bar {
      flex: 1 1 auto;
    }

    .wpk-nav--bar .wpk-nav__list {
      justify-content: center;
    }
  }

  .wpk-nav--bar .wpk-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-block: 0.75rem;
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
  }

  /* A chevron drawn as two borders on a rotated box — no icon set is shipped. */
  .wpk-nav__caret {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-inline-end: 1.5px solid var(--color-text-muted);
    border-block-end: 1.5px solid var(--color-text-muted);
    rotate: 45deg;
    translate: 0 -0.1875rem;
  }

  .wpk-nav__link:hover .wpk-nav__caret,
  .wpk-nav__link:focus-visible .wpk-nav__caret {
    border-color: currentcolor;
  }

  @media (min-width: 1025px) {
    .wpk-nav__item {
      position: relative;
    }

    .wpk-nav__flyout {
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: 0;
      z-index: 2;
      display: none;
      flex-direction: column;
      gap: 0;
      min-inline-size: 10rem;
      padding: 0;
      border-radius: 0 0 var(--radius-md) var(--radius-md);
      background-color: var(--color-background);
      box-shadow: var(--shadow-flyout);
    }

    /* Carries the variant so it outranks the bar padding above rather than
       relying on source order at equal specificity. */
    .wpk-nav--bar .wpk-nav__flyout .wpk-nav__link {
      display: block;
      padding: 0.625rem;
      font-weight: var(--font-weight-medium);
      line-height: 1.25;
    }

    .wpk-nav__item:hover > .wpk-nav__flyout,
    .wpk-nav__item:focus-within > .wpk-nav__flyout {
      display: flex;
    }
  }

  @media (max-width: 1024px) {
    .wpk-nav__list {
      flex-direction: column;
      gap: var(--space-sm);
    }

    /* The variant is in the selector because `.wpk-nav ul`'s list reset
       weighs (0,2,0) and a bare `.wpk-nav__flyout` weighs (0,1,0); without it
       the indent never paints. */
    .wpk-nav--bar .wpk-nav__flyout {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      padding-block-start: var(--space-2xs);
      padding-inline-start: var(--space-md);
    }
  }

  /* ---------------------------------------------------------------- */
  /* columns — the footer                                              */
  /* ---------------------------------------------------------------- */

  .wpk-nav__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: var(--space-lg) var(--space-lg);
  }

  .wpk-nav__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .wpk-nav__columns .wpk-nav__sublist {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .wpk-nav--columns .wpk-nav__link--child {
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-normal);
  }
</style>
