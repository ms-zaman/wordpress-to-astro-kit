---
// Prose — the styling for a rendered body: the bare elements WordPress's
// HTML (or a Markdown body) produces and the Foundation primitives never
// touch. It is not a Foundation component because it styles the output of one
// pipeline, and Foundation components carry no pipeline assumption.
//
// It carries WordPress's own vocabulary where a migrated body needs it: the
// preset colour classes core writes, the button block, alignment classes, and
// the common shapes a page builder leaves behind. Extend it when a capture
// arrives carrying a class that paints nothing — the visibility contract is
// that an unknown class renders unstyled, never invisible.
interface Props {
  /** Constrain to a comfortable measure. Off inside a narrow column. */
  measure?: boolean;
  /** `article` is a post body at the larger reading size. */
  variant?: "default" | "article";
}

const { measure = true, variant = "default" } = Astro.props;
---

<div
  class:list={[
    "wpk-prose",
    measure && "wpk-prose--measure",
    variant === "article" && "wpk-prose--article",
  ]}
>
  <slot />
</div>

<style>
  .wpk-prose--measure {
    max-inline-size: var(--measure);
  }

  .wpk-prose--article {
    font-size: var(--font-size-body-lg);
  }

  .wpk-prose :global(h2) {
    margin-block: var(--space-lg) var(--space-xs);
    font-family: var(--font-family-heading);
    font-size: var(--font-size-heading-md);
    line-height: var(--line-height-snug);
    font-weight: var(--font-weight-semibold);
  }

  .wpk-prose :global(h3) {
    margin-block: var(--space-md) var(--space-2xs);
    font-family: var(--font-family-heading);
    font-size: var(--font-size-heading-sm);
    line-height: var(--line-height-snug);
    font-weight: var(--font-weight-semibold);
  }

  /* h4–h6: a ramp that bottoms out at body size and separates the last two
     levels by weight and colour, so no heading is ever smaller than the
     paragraphs under it (the browser's h5 and h6 defaults are). */
  .wpk-prose :global(h4) {
    margin-block: var(--space-md) var(--space-2xs);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-snug);
    font-weight: var(--font-weight-semibold);
  }

  .wpk-prose :global(h5) {
    margin-block: var(--space-sm) var(--space-2xs);
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-snug);
    font-weight: var(--font-weight-bold);
  }

  .wpk-prose :global(h6) {
    margin-block: var(--space-sm) var(--space-2xs);
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-snug);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .wpk-prose :global(p),
  .wpk-prose :global(ul),
  .wpk-prose :global(ol) {
    margin-block: var(--space-sm);
  }

  .wpk-prose :global(blockquote) {
    margin-inline: 0;
    margin-block: var(--space-md);
    padding-inline-start: var(--space-md);
    border-inline-start: 3px solid var(--color-border-interactive);
    color: var(--color-text-muted);
  }

  .wpk-prose :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .wpk-prose :global(a:hover) {
    color: var(--color-primary-strong);
  }

  /* The button block. `wp-element-button` is core's class; a preset
     background class on the wrapper wins over the default fill below. */
  .wpk-prose :global(a.wp-block-button__link),
  .wpk-prose :global(.wp-element-button) {
    display: inline-block;
    padding: 0.75rem var(--space-lg);
    border-radius: var(--radius-md);
    background-color: var(--wp-button-default);
    color: var(--wp-preset-white);
    text-decoration: none;
  }

  /* WordPress core's preset colour classes. */
  .wpk-prose :global(.has-white-color) {
    color: var(--wp-preset-white);
  }
  .wpk-prose :global(.has-black-color) {
    color: var(--wp-preset-black);
  }
  .wpk-prose :global(.has-vivid-cyan-blue-color) {
    color: var(--wp-preset-vivid-cyan-blue);
  }
  .wpk-prose :global(.has-vivid-purple-color) {
    color: var(--wp-preset-vivid-purple);
  }
  .wpk-prose :global(.has-vivid-red-color) {
    color: var(--wp-preset-vivid-red);
  }
  .wpk-prose :global(.has-white-background-color) {
    background-color: var(--wp-preset-white);
  }
  .wpk-prose :global(.has-black-background-color) {
    background-color: var(--wp-preset-black);
  }
  .wpk-prose :global(.has-pale-cyan-blue-background-color) {
    background-color: var(--wp-preset-pale-cyan-blue);
  }
  .wpk-prose :global(.has-cyan-bluish-gray-background-color) {
    background-color: var(--wp-preset-cyan-bluish-gray);
  }
  .wpk-prose :global(.has-vivid-cyan-blue-background-color) {
    background-color: var(--wp-preset-vivid-cyan-blue);
  }
  .wpk-prose :global(.has-light-green-cyan-background-color) {
    background-color: var(--wp-preset-light-green-cyan);
  }
  .wpk-prose :global(.has-luminous-vivid-amber-background-color) {
    background-color: var(--wp-preset-luminous-vivid-amber);
  }
  .wpk-prose :global(.has-pale-pink-background-color) {
    background-color: var(--wp-preset-pale-pink);
  }

  /* A preset-tinted paragraph or group is a box; give it the padding core's
     editor gives it. */
  .wpk-prose :global(p.has-background),
  .wpk-prose :global(.wp-block-group.has-background) {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
  }

  /* Alignment classes. */
  .wpk-prose :global(.has-text-align-center) {
    text-align: center;
  }
  .wpk-prose :global(.has-text-align-right) {
    text-align: end;
  }
  .wpk-prose :global(.aligncenter) {
    display: block;
    margin-inline: auto;
  }
  .wpk-prose :global(.alignwide),
  .wpk-prose :global(.alignfull) {
    max-inline-size: none;
  }

  /* ---------------------------------------------------------------------
     Gutenberg's own blocks.

     WordPress core's block library styles about ninety block classes, and a
     migrated body from a Gutenberg site is made almost entirely of them.
     Reproducing core's stylesheet would be reproducing somebody else's design;
     what is here is the STRUCTURAL minimum — the blocks that read as broken
     with no rules at all — expressed in this kit's tokens.

     Which classes exist was read off @wordpress/block-library@10.5.0, not
     recalled. Blocks a static migration cannot carry (comments, query loops,
     navigation, search) are deliberately absent: they are dynamic WordPress,
     and if one appears in a captured body it should be a finding, not a style.
     --------------------------------------------------------------------- */

  .wpk-prose :global(.wp-block-quote),
  .wpk-prose :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: var(--space-lg);
    border-inline-start: 3px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .wpk-prose :global(.wp-block-pullquote) {
    padding: var(--space-lg) 0;
    border-block: var(--border-width) solid var(--color-border);
    text-align: center;
  }

  .wpk-prose :global(.wp-block-pullquote blockquote) {
    padding-inline-start: 0;
    border-inline-start: 0;
  }

  /* `cite` is core's attribution line in both quote blocks. */
  .wpk-prose :global(cite) {
    display: block;
    margin-block-start: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.9em;
    font-style: normal;
  }

  /* Columns collapse to one at the mobile breakpoint, which is what core does
     — a two-column block that stays two columns at 320px is the overflow the
     layout audit fails on. */
  .wpk-prose :global(.wp-block-columns) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .wpk-prose :global(.wp-block-column) {
    flex-basis: 100%;
    flex-grow: 1;
    min-inline-size: 0;
  }

  @media (min-width: 768px) {
    .wpk-prose :global(.wp-block-column) {
      flex-basis: 0;
    }
  }

  .wpk-prose :global(figure),
  .wpk-prose :global(.wp-block-image) {
    margin-inline: 0;
  }

  /* Core's caption class changed name between eras and a migrated corpus
     carries both: `wp-caption-text` from the classic editor,
     `wp-element-caption` from the block editor, plain `figcaption` from
     everything else. */
  .wpk-prose :global(figcaption),
  .wpk-prose :global(.wp-caption-text),
  .wpk-prose :global(.wp-element-caption) {
    margin-block-start: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.9em;
  }

  .wpk-prose :global(.wp-block-gallery) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .wpk-prose :global(.wp-block-gallery .wp-block-image) {
    flex-grow: 1;
    flex-basis: 12rem;
  }

  .wpk-prose :global(.wp-block-separator),
  .wpk-prose :global(hr) {
    border: 0;
    border-block-start: var(--border-width) solid var(--color-border);
    margin-block: var(--space-xl);
  }

  .wpk-prose :global(.wp-block-separator.is-style-wide) {
    inline-size: 100%;
  }

  .wpk-prose :global(.wp-block-spacer) {
    /* Core gives it an inline height; without a display rule it is an empty
       inline box and the height does nothing. */
    display: block;
  }

  /* Verse is a `<pre>`, so the browser would set it in monospace — core
     explicitly overrides that to the body font, because verse is poetry and
     not code. Measured, not assumed: `:where(pre.wp-block-verse){font-family:
     inherit}` in core's own stylesheet. */
  .wpk-prose :global(.wp-block-verse) {
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    /* Core deliberately un-monospaces verse, and the walk caught this kit
       putting the distinction straight back: verse is a `<pre>`, so the
       generic `pre` rule below boxed it in a code-block surface and it read as
       code again. Poetry keeps the body font and the body ground; only the
       line breaks are preserved. */
    padding: 0;
    background: none;
    font-family: inherit;
    font-size: inherit;
  }

  /* Core lets a code block WRAP rather than scroll, and that is the rule the
     layout audit needs: an unbreakable token in a migrated code block is the
     same 320px overflow an inline `<code>` caused on this kit's own contact
     page. */
  .wpk-prose :global(.wp-block-code code) {
    display: block;
    overflow-wrap: break-word;
    white-space: break-spaces;
  }

  .wpk-prose :global(.wp-block-details summary) {
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
  }

  .wpk-prose :global(.wp-block-media-text) {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  @media (min-width: 768px) {
    .wpk-prose :global(.wp-block-media-text) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .wpk-prose :global(.wp-block-cover) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
    background-size: cover;
    background-position: center;
  }

  /* A cover's text is painted on an image, so it carries its own ground. The
     contrast audit reads what is actually behind the text and would otherwise
     have nothing to measure against. */
  .wpk-prose :global(.wp-block-cover__inner-container) {
    position: relative;
  }

  /* ---------------------------------------------------------------------
     The classic editor's alignment classes.

     Core still ships these because two decades of posts carry them, and a
     migrated corpus from any site older than the block editor is full of
     them. `aligncenter`, `alignwide` and `alignfull` are handled above.
     --------------------------------------------------------------------- */

  .wpk-prose :global(.alignleft) {
    float: inline-start;
    margin-inline-end: var(--space-lg);
    margin-block-end: var(--space-md);
  }

  .wpk-prose :global(.alignright) {
    float: inline-end;
    margin-inline-start: var(--space-lg);
    margin-block-end: var(--space-md);
  }

  /* A float at 320px is a column two words wide. Below the mobile breakpoint
     the image becomes a block, which is what every WordPress theme does and
     what stops `layout:audit` failing on a migrated post. */
  @media (max-width: 767px) {
    .wpk-prose :global(.alignleft),
    .wpk-prose :global(.alignright) {
      float: none;
      margin-inline: 0;
    }
  }

  .wpk-prose :global(.wp-caption) {
    max-inline-size: 100%;
  }

  /* Core's own visually-hidden utility. A migrated body uses it for real
     accessible names, so it must hide visually and stay in the accessibility
     tree — the content reconciler treats these as content for the same
     reason. */
  .wpk-prose :global(.screen-reader-text) {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ---------------------------------------------------------------------
     Other builders' residue: a button, an alert box, an accordion header.
     Kept to shapes, never to a builder's colours.
     --------------------------------------------------------------------- */
  .wpk-prose :global(a.elementor-button),
  .wpk-prose :global(a.cta-button) {
    display: inline-block;
    padding: 0.75rem var(--space-lg);
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    text-decoration: none;
  }

  .wpk-prose :global(.elementor-alert) {
    padding: var(--space-md) var(--space-lg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .wpk-prose :global(.elementor-tab-title),
  .wpk-prose :global(.eael-accordion-header) {
    font-weight: var(--font-weight-semibold);
  }

  /* An icon-font glyph with no font shipped is an empty element; hide it
     rather than leave an empty inline box in the text. */
  .wpk-prose :global([class*="fa-"]:empty) {
    display: none;
  }

  .wpk-prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    font-size: 0.9em;
    /* An inline code span is one unbreakable word to a browser: no break
       opportunity exists inside `apps/website/src/forms/definitions.ts`,
       because nothing breaks at a slash by default. At 320px that one span
       measured 331px and pushed the whole document to a scrollWidth of 355 —
       found by `layout:audit` on its first run over this kit, not by looking.
       A block that scrolls (`pre`, `table`) solves this by scrolling; an
       inline span has to be allowed to break. */
    overflow-wrap: break-word;
  }

  .wpk-prose :global(img) {
    max-inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-md);
  }

  /* Wide content scrolls inside its own container; the page never does. */
  .wpk-prose :global(pre),
  .wpk-prose :global(table) {
    max-inline-size: 100%;
    overflow-x: auto;
  }

  .wpk-prose :global(pre) {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-normal);
  }

  .wpk-prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .wpk-prose :global(table) {
    display: block;
    border-collapse: collapse;
  }

  .wpk-prose :global(th),
  .wpk-prose :global(td) {
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    text-align: start;
  }

  .wpk-prose :global(th) {
    background-color: var(--color-surface);
    font-weight: var(--font-weight-semibold);
  }

  /* Embeds keep their ratio and never overflow. */
  .wpk-prose :global(iframe),
  .wpk-prose :global(video),
  .wpk-prose :global(object),
  .wpk-prose :global(embed) {
    max-inline-size: 100%;
  }

  .wpk-prose :global(.wp-block-embed__wrapper iframe),
  .wpk-prose :global(.wp-video),
  .wpk-prose :global(.wp-video video) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
  }

  .wpk-prose :global(figure) {
    margin-inline: 0;
    margin-block: var(--space-md);
  }

  .wpk-prose :global(figcaption) {
    margin-block-start: var(--space-2xs);
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
  }
</style>
