    "content:contract": "node content-contract/run.ts",
    "render:contract": "node render-contract/run.ts",
    "render:build-audit": "node render-contract/build-audit.ts"
  },
  "dependencies": {
    "@wpk/ui": "workspace:*",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
