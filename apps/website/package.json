{
  "name": "@wpk/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Astro site. Static-first; every launch-time difference between the preview and the production build is decided by src/deployment/site-environment.ts.",
  "scripts": {
